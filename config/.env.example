# Copy to config/.env for local use. Never commit real credentials.
MYSQL_LOGIN_PATH=local-auto
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=auto_pipeline
MYSQL_PASSWORD=
MYSQL_CHARSET=utf8mb4
MYSQL_OPS_DATABASE=auto_ops
MYSQL_RAW_DATABASE=auto_raw
MYSQL_STAGING_DATABASE=auto_staging
MYSQL_MART_DATABASE=auto_mart

# Optional review-label settings; leave empty for the default offline pipeline.
REVIEW_LABEL_API_KEY=
REVIEW_LABEL_MODEL=
REVIEW_LABEL_BASE_URL=
REVIEW_LABEL_TIMEOUT=60
